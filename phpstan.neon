#https://phpstan.org/user-guide/getting-started

parameters:
    level: 7
    paths:
        - src
        - tests
    excludePaths:
        - vendor/*

    reportUnmatchedIgnoredErrors: true

    ignoreErrors:
        -
            identifier: missingType.generics
        -
            identifier: missingType.iterableValue

    fileExtensions:
        - php

includes:
    - phpstan-baseline.neon
